<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>AstralDeep</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>AstralDeep</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Required by the Mac App Store: without it, altool rejects the .pkg with
	     "The product archive is invalid. The Info.plist must contain a
	     LSApplicationCategoryType key." Harmless on iOS, which ignores it.
	     This is the Info.plist category; the store listing's category is set
	     separately in App Store Connect and should agree with it. -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<!-- Feature 053 — the backend URL and Keycloak realm come from the xcconfig
	     (Config/{Base,Debug,Release}.xcconfig) and are read at launch by
	     AstralCore.AstralConfig. Repointing a build needs no source edit. -->
	<key>ASTRALDistribution</key>
	<string>$(ASTRAL_DISTRIBUTION)</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Astral observes your desktop only during a computer-control session that you explicitly enable. You can pause or stop access at any time.</string>
	<key>ASTRALServerBaseURL</key>
	<string>$(ASTRAL_SERVER_BASE_URL)</string>
	<key>ASTRALKeycloakAuthority</key>
	<string>$(ASTRAL_KEYCLOAK_AUTHORITY)</string>
	<key>SUFeedURL</key>
	<string>https://astraldeep.github.io/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>eg4hW6POM2f99hfVp8K+U5bx5Hpl8+P+IYLuW0+pPzw=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<key>SUAutomaticallyUpdate</key>
	<false/>
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
	<key>SUShowReleaseNotes</key>
	<true/>
	<!-- ATS: no NSAllowsArbitraryLoads. Release talks HTTPS to the hosted backend
	     and is fully ATS-compliant. NSAllowsLocalNetworking only relaxes ATS for
	     loopback/.local addresses (so Debug can reach http://localhost:8001); it
	     is App-Store-safe and never permits an insecure load to a public host. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>AstralDeep uses the microphone only while you explicitly run a voice conversation.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>AstralDeep uses on-device speech recognition only while you explicitly run a voice conversation. Spoken audio is processed on this device and is never uploaded.</string>
	<key>NSCameraUsageDescription</key>
	<string>AstralDeep never captures photos or video. The real-time voice framework links camera APIs, so this permission text is required, but the app does not request camera access.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.personalailabs.astraldeep.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.personalailabs.astraldeep</string>
			</array>
		</dict>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
